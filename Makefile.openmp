# ---------------------------------------------------------------------------
#  OpenMP support, shared by every FreeImage makefile.
#  OPENMP_CFLAGS on C and C++ alike (LibRaw ODR), OPENMP_LDFLAGS on links.
# ---------------------------------------------------------------------------

# 1 = build with OpenMP, 0 = build single-threaded.
OPENMP ?= 1

ifeq ($(OPENMP),0)

OPENMP_CFLAGS  =
OPENMP_LDFLAGS =

else
ifeq ($(OPENMP_DETECT),1)

# ---------------------------------------------------------------------------
#  Probed mode (Makefile.osx): Apple clang ships no libomp.
# ---------------------------------------------------------------------------

# compiler to probe
OPENMP_CC ?= $(CC)

OPENMP_PROBE_OUT ?= .fi-openmp-probe.out
OPENMP_BREW_PREFIX ?= $(firstword $(wildcard \
    $(shell brew --prefix libomp 2>/dev/null) \
    /opt/homebrew/opt/libomp \
    /usr/local/opt/libomp))

# '\#' is how a literal '#' is spelled inside a make variable.
OPENMP_HASH := \#

# $(call openmp-works,<compile flags>,<link flags>) -> "yes" when a probe builds.
openmp-works = $(shell printf '$(OPENMP_HASH)include <omp.h>\nint main(void){return omp_get_max_threads() > 0 ? 0 : 1;}\n' \
    | $(OPENMP_CC) $(1) -x c - $(2) -o $(OPENMP_PROBE_OUT) >/dev/null 2>&1 && echo yes; \
    rm -f $(OPENMP_PROBE_OUT))

# no probe when the flags are given
ifeq ($(origin OPENMP_CFLAGS),undefined)

ifeq ($(call openmp-works,-fopenmp,-fopenmp),yes)
OPENMP_CFLAGS  = -fopenmp
OPENMP_LDFLAGS = -fopenmp
else
ifneq ($(OPENMP_BREW_PREFIX),)
ifeq ($(call openmp-works,-Xpreprocessor -fopenmp -I$(OPENMP_BREW_PREFIX)/include,-L$(OPENMP_BREW_PREFIX)/lib -lomp),yes)
OPENMP_CFLAGS  = -Xpreprocessor -fopenmp -I$(OPENMP_BREW_PREFIX)/include
OPENMP_LDFLAGS = -L$(OPENMP_BREW_PREFIX)/lib -lomp
endif
endif
endif

ifeq ($(strip $(OPENMP_CFLAGS)),)
$(warning FreeImage: '$(OPENMP_CC)' has no usable OpenMP - building single-threaded.)
$(warning FreeImage: on macOS 'brew install libomp' enables it, or set OPENMP_CFLAGS/OPENMP_LDFLAGS by hand, or pass OPENMP=0 to silence this.)
OPENMP_CFLAGS  =
OPENMP_LDFLAGS =
endif

endif

else

# ---------------------------------------------------------------------------
#  Assumed mode: GCC and GCC-compatible clang.
# ---------------------------------------------------------------------------
OPENMP_CFLAGS  ?= -fopenmp
OPENMP_LDFLAGS ?= -fopenmp

endif
endif
