# ---------------------------------------------------------------------------
#  HEIF/HEIC support (libheif + libde265), shared by every FreeImage makefile.
#
#  FreeImage builds every bundled library from one flat list of sources with
#  one set of flags (Makefile.srcs).  The two libraries behind the HEIF plugin
#  (Source/LibHEIF, Source/LibDe265) do not fit that mould in three ways, and
#  this file closes the gaps:
#
#   1. Their sources are C++ files named *.cc.  Every makefile has a .cc rule
#      of the form
#
#          $(CXX) $(HEIF_CXXFLAGS_PRE) $(CXXFLAGS) $(HEIF_CXXFLAGS_POST) -c $< -o $@
#
#      and the two extra variables are set per target pattern below.  They are
#      empty for any other .cc file.
#
#   2. libheif is C++20 and libde265 is C++17, while the rest of FreeImage is
#      compiled as C++0x/11.  A later -std= flag overrides an earlier one, so
#      the standard is appended after $(CXXFLAGS).
#
#   3. Both libraries include their own headers by short generic names
#      (bitstream.h, image.h, util.h, error.h ...) that also exist elsewhere in
#      the tree (Source/LibOpenJPEG/image.h, Source/LibDav1d/config.h ...).
#      Their own directories are therefore *prepended* so they win over the
#      global $(INCLUDE), and neither directory is on the global list.  The only
#      global addition is Source/LibHEIF/libheif/api, whose sole content is the
#      libheif/ subdirectory of public headers used by PluginHEIF.cpp.
#
#  libde265 is configured through -D flags instead of a config.h (every one of
#  its "config.h" includes is guarded by HAVE_CONFIG_H, which is never defined
#  here), so no config.h of ours can be picked up by, or shadow, another
#  library's.  The MSVC projects (LibHEIF.2017.vcxproj, LibDe265.2017.vcxproj)
#  spell out the same defines.
#
#  libde265's x86 SIMD kernels (libde265/x86/) are portable C++ intrinsics:
#  the sse-*.cc files need -msse4.1 (they run only after sse.cc's runtime CPU
#  check, which is deliberately compiled without it), transform-avx2.cc needs
#  -mavx2 and transform-avx512.cc needs -mavx512f -mavx512bw.  On a non-x86
#  host the whole x86/ directory is dropped from the build; the scalar
#  fallbacks are always compiled.  HEIF_MACHINE can be overridden for cross
#  builds.
# ---------------------------------------------------------------------------

HEIF_MACHINE ?= $(shell uname -m 2>/dev/null || echo unknown)
HEIF_SYSTEM ?= $(shell uname -s 2>/dev/null || echo unknown)

# defaults for .cc files that belong to neither library
HEIF_CXXFLAGS_PRE =
HEIF_CXXFLAGS_POST =

# --- libde265 (HEVC decoder) -----------------------------------------------

LIBDE265_CXXFLAGS_PRE = -ISource/LibDe265 -ISource/LibDe265/libde265
# LIBDE265_STATIC_BUILD: no __declspec(dllimport/dllexport) on Windows
# DE265_LOG_ERROR: libde265's default log level ("error")
LIBDE265_CXXFLAGS_POST = -std=c++17 -DLIBDE265_STATIC_BUILD -DDE265_LOG_ERROR -DHAVE_POSIX_MEMALIGN=1

# <malloc.h> is where MinGW declares __mingw_aligned_malloc (libde265/image.cc)
ifneq (,$(findstring MINGW,$(HEIF_SYSTEM))$(findstring MSYS,$(HEIF_SYSTEM)))
LIBDE265_CXXFLAGS_POST += -DHAVE_MALLOC_H=1
endif

ifneq (,$(filter x86_64 amd64 i86pc i386 i486 i586 i686,$(HEIF_MACHINE)))
LIBDE265_CXXFLAGS_POST += -DHAVE_SSE4_1=1
LIBDE265_SSE_FLAGS = -msse2 -mssse3 -msse4.1
ifneq (,$(filter x86_64 amd64,$(HEIF_MACHINE)))
# the AVX kernels are dispatched with __builtin_cpu_supports(), GCC/clang only
LIBDE265_CXXFLAGS_POST += -DHAVE_AVX2=1 -DHAVE_AVX512=1
endif
else
SRCS := $(filter-out ./Source/LibDe265/libde265/x86/%,$(SRCS))
endif

./Source/LibDe265/%: HEIF_CXXFLAGS_PRE = $(LIBDE265_CXXFLAGS_PRE)
./Source/LibDe265/%: HEIF_CXXFLAGS_POST = $(LIBDE265_CXXFLAGS_POST) $(LIBDE265_SIMD_FLAGS)
./Source/LibDe265/libde265/x86/sse-%: LIBDE265_SIMD_FLAGS = $(LIBDE265_SSE_FLAGS)
./Source/LibDe265/libde265/x86/transform-avx2.%: LIBDE265_SIMD_FLAGS = -mavx2
./Source/LibDe265/libde265/x86/transform-avx512.%: LIBDE265_SIMD_FLAGS = -mavx512f -mavx512bw

# --- libheif (HEIF container) ----------------------------------------------

LIBHEIF_CXXFLAGS_PRE = -ISource/LibHEIF/libheif -ISource/LibHEIF/libheif/api -ISource/LibDe265
# HAVE_LIBDE265: the libde265 decoder is compiled in (no dynamic plugin loading)
# ENABLE_MULTITHREADING_SUPPORT / ENABLE_PARALLEL_TILE_DECODING: libheif's defaults
# LIBHEIF_STATIC_BUILD / LIBDE265_STATIC_BUILD: see above; libheif includes de265.h
#
# The other decoders are wired to libraries FreeImage already bundles, so a HEIF
# file whose payload is not HEVC still opens:
#   HAVE_JPEG_DECODER=1     -> libheif/plugins/decoder_jpeg.cc  -> Source/LibJPEG
#                              (also decodes the JPEG 'thmb' thumbnails Sony HIF
#                              files carry, and JPEG-in-HEIF payloads)
#   WITH_UNCOMPRESSED_CODEC=1 -> libheif/codecs/uncompressed/*.cc and image-items/
#                              unc_image.cc plus the unci decoder/encoder plugins
#                              (ISO/IEC 23001-17 uncompressed)
#   HAVE_ZLIB=1             -> libheif/compression_zlib.cc -> Source/ZLib, for the
#                              zlib/deflate-compressed variant of an 'unci' item
# The bundled -ISource/LibJPEG and -ISource/ZLib are already on the global include
# path; the MSVC project adds them itself.
#
# JPEG 2000 is deliberately NOT enabled: the bundled Source/LibOpenJPEG is 2.0.0
# (2013) and mis-decodes J2K-in-HEIF (verified - the j2k test image loses detail
# and colour against its lossless 'unci' reference, while JPEG and HEVC of the same
# image are exact).  Enabling it cleanly needs a newer OpenJPEG, which is shared
# with FreeImage's own J2K/JP2 plugins.  So no AVC (H.264), VVC or JPEG 2000 decoder
# is enabled, and those payloads are reported and skipped.
LIBHEIF_CXXFLAGS_POST = -std=c++20 -DLIBHEIF_STATIC_BUILD -DLIBDE265_STATIC_BUILD -DHAVE_LIBDE265=1 -DENABLE_MULTITHREADING_SUPPORT=1 -DENABLE_PARALLEL_TILE_DECODING=1 -DHAVE_JPEG_DECODER=1 -DWITH_UNCOMPRESSED_CODEC=1 -DHAVE_ZLIB=1

./Source/LibHEIF/%: HEIF_CXXFLAGS_PRE = $(LIBHEIF_CXXFLAGS_PRE)
./Source/LibHEIF/%: HEIF_CXXFLAGS_POST = $(LIBHEIF_CXXFLAGS_POST)
