# ---------------------------------------------------------------------------
#  HEIF/HEIC support (libheif + libde265), shared by every FreeImage makefile.
#  Per-library -std and -I flags; the -I dirs go first (header names clash).
# ---------------------------------------------------------------------------

HEIF_MACHINE ?= $(shell uname -m 2>/dev/null || echo unknown)
HEIF_SYSTEM ?= $(shell uname -s 2>/dev/null || echo unknown)

# defaults for .cc files that belong to neither library
HEIF_CXXFLAGS_PRE =
HEIF_CXXFLAGS_POST =

# --- libde265 (HEVC decoder) -----------------------------------------------

LIBDE265_CXXFLAGS_PRE = -ISource/LibDe265 -ISource/LibDe265/libde265
LIBDE265_CXXFLAGS_POST = -std=c++17 -DLIBDE265_STATIC_BUILD -DDE265_LOG_ERROR -DHAVE_POSIX_MEMALIGN=1

# MinGW declares __mingw_aligned_malloc in <malloc.h>
ifneq (,$(findstring MINGW,$(HEIF_SYSTEM))$(findstring MSYS,$(HEIF_SYSTEM)))
LIBDE265_CXXFLAGS_POST += -DHAVE_MALLOC_H=1
endif

ifneq (,$(filter x86_64 amd64 i86pc i386 i486 i586 i686,$(HEIF_MACHINE)))
LIBDE265_CXXFLAGS_POST += -DHAVE_SSE4_1=1
LIBDE265_SSE_FLAGS = -msse2 -mssse3 -msse4.1
ifneq (,$(filter x86_64 amd64,$(HEIF_MACHINE)))
# the AVX kernels are dispatched with __builtin_cpu_supports(), GCC/clang only
LIBDE265_CXXFLAGS_POST += -DHAVE_AVX2=1 -DHAVE_AVX512=1
endif
else
SRCS := $(filter-out ./Source/LibDe265/libde265/x86/%,$(SRCS))
endif

./Source/LibDe265/%: HEIF_CXXFLAGS_PRE = $(LIBDE265_CXXFLAGS_PRE)
./Source/LibDe265/%: HEIF_CXXFLAGS_POST = $(LIBDE265_CXXFLAGS_POST) $(LIBDE265_SIMD_FLAGS)
./Source/LibDe265/libde265/x86/sse-%: LIBDE265_SIMD_FLAGS = $(LIBDE265_SSE_FLAGS)
./Source/LibDe265/libde265/x86/transform-avx2.%: LIBDE265_SIMD_FLAGS = -mavx2
./Source/LibDe265/libde265/x86/transform-avx512.%: LIBDE265_SIMD_FLAGS = -mavx512f -mavx512bw

# --- libheif (HEIF container) ----------------------------------------------

LIBHEIF_CXXFLAGS_PRE = -ISource/LibHEIF/libheif -ISource/LibHEIF/libheif/api -ISource/LibDe265
# decoders: HEVC, JPEG, J2K, uncompressed/zlib (bundled libs); no AVC/VVC
# OPJ_STATIC: openjpeg.h is included here too
LIBHEIF_CXXFLAGS_POST = -std=c++20 -DLIBHEIF_STATIC_BUILD -DLIBDE265_STATIC_BUILD -DHAVE_LIBDE265=1 -DENABLE_MULTITHREADING_SUPPORT=1 -DENABLE_PARALLEL_TILE_DECODING=1 -DHAVE_JPEG_DECODER=1 -DWITH_UNCOMPRESSED_CODEC=1 -DHAVE_ZLIB=1 -DHAVE_OPENJPEG_DECODER=1 -DOPJ_STATIC

./Source/LibHEIF/%: HEIF_CXXFLAGS_PRE = $(LIBHEIF_CXXFLAGS_PRE)
./Source/LibHEIF/%: HEIF_CXXFLAGS_POST = $(LIBHEIF_CXXFLAGS_POST)
