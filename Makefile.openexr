# ---------------------------------------------------------------------------
#  OpenEXR 3.3, shared by every FreeImage makefile.
#  Its own .cpp files need C++14 or later (OPENEXR_CXXSTD, default c++17).
# ---------------------------------------------------------------------------

OPENEXR_CXXSTD ?= -std=c++17

# Makefile.solaris spells CXXFLAGS as CPPFLAGS
Source/OpenEXR/%.o: CXXFLAGS += $(OPENEXR_CXXSTD)
Source/OpenEXR/%.o: CPPFLAGS += $(OPENEXR_CXXSTD)

# Makefile.osx: per-architecture flags
Source/OpenEXR/%.o-i386: CPPFLAGS_I386 += $(OPENEXR_CXXSTD)
Source/OpenEXR/%.o-x86_64: CPPFLAGS_X86_64 += $(OPENEXR_CXXSTD)

# Makefile.iphone: simulator and device
Source/OpenEXR/%.o-i686: CXXFLAGS_SIM += $(OPENEXR_CXXSTD)
Source/OpenEXR/%.o-arm: CXXFLAGS_PHONE += $(OPENEXR_CXXSTD)
