# ---------------------------------------------------------------------------
#  OpenEXR 3.3, shared by every FreeImage makefile.
#
#  FreeImage compiles its C++ as C++0x/11 (see CXXFLAGS in each makefile), and
#  that is no longer enough for the bundled OpenEXR: since 3.3 the library is
#  written against a newer standard, and IlmThreadProcessGroup.h - pulled in by
#  the scanline, tiled and deep readers - constrains its class template with
#  std::enable_if_t, which is C++14.  Compiled as C++11 the template is never
#  declared and every use of it fails.
#
#  Source/OpenEXR/**/*.cpp therefore gets -std=c++17 appended after the general
#  flags, where a later -std= overrides the earlier one.  This is the same
#  mechanism Makefile.heif uses to give libheif C++20 and libde265 C++17.  C++14
#  is the language floor; 17 is what OpenEXR's own CMake build uses by default
#  (cmake/OpenEXRSetup.cmake picks 17 for VFX Platform 21), so it is what the
#  library is actually tested with.  Override with e.g.
#
#      make OPENEXR_CXXSTD=-std=c++14
#
#  Only OpenEXR's own sources need this.  Source/FreeImage/PluginEXR.cpp still
#  compiles as C++11: the public headers it includes (ImfInputFile.h,
#  ImfRgbaFile.h, ImfOutputFile.h ...) stay inside C++11, and no OpenEXR header
#  changes a class definition on __cplusplus, so the plugin and the library
#  agree on every type they share.
#
#  Nothing here applies to the C half of the bundle.  Source/OpenEXR/OpenEXRCore
#  (the C library the 3.3 C++ API reads and writes through) and Source/LibDeflate
#  (the ZIP/DWA codec OpenEXRCore compresses with - OpenEXR 3.3 no longer uses
#  zlib for EXR data) are C99, and are compiled by the ordinary .c rule.  They do
#  need POSIX declarations that a strict -std=c99 hides, which is why the three
#  makefiles that set an explicit C standard ask for gnu99; see Makefile.gnu.
#
#  Of libdeflate only the eight sources OpenEXR itself compiles are in SRCS -
#  the EXR_DEFLATE_SOURCES list in cmake/OpenEXRSetup.cmake, which leaves out
#  crc32.c and the two gzip files.  The rest of the upstream tree is kept in
#  Source/LibDeflate so the copy can be diffed against a release tarball.
# ---------------------------------------------------------------------------

OPENEXR_CXXSTD ?= -std=c++17

# Makefile.gnu, Makefile.fip, Makefile.cygwin, Makefile.solaris, Makefile.mingw
Source/OpenEXR/%.o: CXXFLAGS += $(OPENEXR_CXXSTD)

# Makefile.osx builds one object per architecture, with its own flags variable
Source/OpenEXR/%.o-i386: CPPFLAGS_I386 += $(OPENEXR_CXXSTD)
Source/OpenEXR/%.o-x86_64: CPPFLAGS_X86_64 += $(OPENEXR_CXXSTD)

# Makefile.iphone, likewise: simulator and device
Source/OpenEXR/%.o-i686: CXXFLAGS_SIM += $(OPENEXR_CXXSTD)
Source/OpenEXR/%.o-arm: CXXFLAGS_PHONE += $(OPENEXR_CXXSTD)
